# Copy this file to .env (or set the same variables where the site runs).

# The address of the CRM. The site reads the published jobs from  <CRM_API_URL>/api/v1/public/jobs
# and sends applications to  <CRM_API_URL>/api/v1/public/applications
CRM_API_URL=https://crm.example.com

# The slug of the organisation in the CRM whose jobs are shown (the public jobs list is per organisation)
CAREERS_ORG=acme-recruiting

# Where this site listens
PORT=3100
# 127.0.0.1 behind a reverse proxy on the same machine, 0.0.0.0 inside Docker
HOST=127.0.0.1
